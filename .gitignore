# Build outputs
build/
*.orig
apps/lv_port_linux/build/
apps/hdmi_preview/build/
**/dist/
**/.cache/
platform/app-sdk/examples/*/bin/

# SDK artifacts
out/
staging_dir/

# Local reports
reports/
*.log
/output/

# Local release inputs and capture intermediates. Public source exports are
# generated beside the repository and must never be assembled from these.
/a133-kvm-example/*.tar
/a133-kvm-example/*.tar.gz
/a133-kvm-example/*.tgz
/docs/debug-evidence/**/*.raw
/docs/debug-evidence/**/*.raw.gz

# Editor files
.DS_Store
*.swp
.playwright-cli/

# TuyaOpen out-of-tree build root (prepare 脚本生成,不提交)
.tuyaopen-build/

# Vendored TuyaOpen source stays visible despite broad output rules. The
# downloaded `.tools` runtime and platform/LINUX build tree are explicitly
# excluded below and must never be force-added to a public candidate.
!third_party/TuyaOpen/

# Python bytecode generated by host-side tests and tooling.
**/__pycache__/
*.py[co]

# Local secrets
secrets/
ops-export/
public-export/
*.sqlite
*.sqlite3
*.xlsx
*.p12
*.pfx
*.jks
*_private.pem
id_rsa*
id_ed25519*

# Hardware drawings are private release inputs and must not enter public refs.
/R818_*.pdf

# Public-source boundary: keep local/private inputs available for internal
# builds, but never add them to the history-free public candidate.
/CURRENT_STATE.md
/artifacts/
/third_party/100ask-iot-sdk/
/third_party/TuyaOpen/.tools/
/third_party/TuyaOpen/platform/LINUX/build/
/tools/factory-assistant/factory-assistant-v1/02-密钥/
/tools/factory-assistant/factory-assistant-v1/03-涂鸦/
/tools/factory-assistant/factory-assistant-v1/data/
/tools/factory-assistant/factory-core/target/
/vendor/tuyaopen-a133-b6-libs/

# Claude Code session/config（本地会话目录，不入库）
.claude/
