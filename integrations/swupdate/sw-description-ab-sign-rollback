/* AITVBox A/B OTA 全量升级描述（Phase 1，App 触发，RSA 签名）。
 *
 * 基于 SDK 的 sw-description-ab-sign，两处关键改动：
 *   1. 去掉 uboot/boot0 升级（Phase 1 不动 bootloader，降低变砖风险）。
 *   2. 补回滚 env：stock 模板只切槽位，无失败回滚。本版每分支额外写
 *      upgrade_available=1 / bootcount=0 / bootlimit=3 / 方向化 altbootcmd。
 *      升级到 B 时 altbootcmd 切回 A；升级到 A 时切回 B。
 *      新槽启动失败、bootcount 超 bootlimit → U-Boot 跑 altbootcmd 回旧槽。
 *      用户态确认新槽正常后 fw_setenv upgrade_available 0（commit）停止计数。
 *
 * 回滚依赖 Phase 0 注入的 U-Boot BOOTCOUNT_LIMIT/ENV + env.cfg 的 bootlimit/altbootcmd。
 *
 * 用法（设备侧）：
 *   当前在 A：swupdate -i upgrade.swu -e stable,now_A_next_B -k /etc/swupdate_public.pem
 *   当前在 B：swupdate -i upgrade.swu -e stable,now_B_next_A -k /etc/swupdate_public.pem
 */
software =
{
    version = "0.1.0";
    description = "AITVBox firmware update (A/B full, signed, rollback)";

    stable = {

        /* now in systemA, we need to upgrade systemB(bootB, rootfsB) */
        now_A_next_B = {
            images: (
                {
                    filename = "kernel";
                    device = "/dev/by-name/bootB";
                    sha256 = "@kernel";
                    installed-directly = true;
                },
                {
                    filename = "rootfs";
                    device = "/dev/by-name/rootfsB";
                    sha256 = "@rootfs";
                    installed-directly = true;
                    /* Phase 1.5: rootfs 走 gzip 压缩传输（subimgs cfg 指向 rootfs.img.gz）。
                     * 设备端 CONFIG_GUNZIP=y 流式解压直写分区，512M→~110M。sha256 对 .gz 算。 */
                    compressed = "zlib";
                }
            );
            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootB";
                },
                {
                    name = "root_partition";
                    value = "rootfsB";
                },
                {
                    name = "rootdev";
                    value = "mmcblk0p6";
                },
                {
                    name = "systemAB_next";
                    value = "B";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                },
                /* 回滚：进入"升级尝试中"态，启动计数，超限切回 A。 */
                {
                    name = "upgrade_available";
                    value = "1";
                },
                {
                    name = "bootcount";
                    value = "0";
                },
                {
                    name = "bootlimit";
                    value = "3";
                },
                {
                    name = "altbootcmd";
                    value = "setenv boot_partition bootA; setenv root_partition rootfsA; setenv rootdev mmcblk0p4; setenv upgrade_available 0; setenv bootcount 0; saveenv; run setargs_mmc boot_normal";
                }
            );
        };

        /* now in systemB, we need to upgrade systemA(bootA, rootfsA) */
        now_B_next_A = {
            images: (
                {
                    filename = "kernel";
                    device = "/dev/by-name/bootA";
                    sha256 = "@kernel";
                    installed-directly = true;
                },
                {
                    filename = "rootfs";
                    device = "/dev/by-name/rootfsA";
                    sha256 = "@rootfs";
                    installed-directly = true;
                    compressed = "zlib";
                }
            );
            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootA";
                },
                {
                    name = "root_partition";
                    value = "rootfsA";
                },
                {
                    name = "rootdev";
                    value = "mmcblk0p4";
                },
                {
                    name = "systemAB_next";
                    value = "A";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                },
                /* 回滚：进入"升级尝试中"态，超限切回 B。 */
                {
                    name = "upgrade_available";
                    value = "1";
                },
                {
                    name = "bootcount";
                    value = "0";
                },
                {
                    name = "bootlimit";
                    value = "3";
                },
                {
                    name = "altbootcmd";
                    value = "setenv boot_partition bootB; setenv root_partition rootfsB; setenv rootdev mmcblk0p6; setenv upgrade_available 0; setenv bootcount 0; saveenv; run setargs_mmc boot_normal";
                }
            );
        };
    };

    /* when not call with -e xxx,xxx    just clean */
    bootenv: (
        {
            name = "swu_param";
            value = "";
        },
        {
            name = "swu_software";
            value = "";
        },
        {
            name = "swu_mode";
            value = "";
        },
        {
            name = "swu_version";
            value = "";
        }
    );

}
