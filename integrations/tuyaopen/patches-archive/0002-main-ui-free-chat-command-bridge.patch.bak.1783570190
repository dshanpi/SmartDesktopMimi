+static const char *__main_ui_chat_mode_name(AI_CHAT_MODE_E mode)
+{
+    switch (mode) {
+    case AI_CHAT_MODE_FREE:
+        return "free";
+    case AI_CHAT_MODE_WAKEUP:
+        return "wakeup";
+    case AI_CHAT_MODE_HOLD:
+        return "hold";
+    case AI_CHAT_MODE_ONE_SHOT:
+        return "one_shot";
+    default:
+        return "unknown";
+    }
+}
