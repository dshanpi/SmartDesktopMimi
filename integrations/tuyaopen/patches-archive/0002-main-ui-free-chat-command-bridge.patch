+static void __main_ui_break_chat(void)
+{
+#if defined(ENABLE_COMP_AI_AUDIO) && (ENABLE_COMP_AI_AUDIO == 1)
+    ai_audio_player_stop(AI_AUDIO_PLAYER_ALL);
+    tuya_ai_input_stop();
+#endif
+    tuya_ai_agent_event(AI_EVENT_CHAT_BREAK, 0);
