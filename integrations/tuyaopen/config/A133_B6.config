CONFIG_PROJECT_VERSION="1.0.1"
CONFIG_TUYA_PRODUCT_ID="alon7qgyjj8yus74"
CONFIG_ENABLE_AI_LANGUAGE_ENGLISH=y
# CONFIG_ENABLE_AI_LANGUAGE_CHINESE is not set
CONFIG_ENABLE_COMP_AI_AUDIO_CODEC_OPUS=y
# CONFIG_ENABLE_COMP_AI_DISPLAY is not set
CONFIG_ENABLE_UART=y
CONFIG_KWS_MODEL_PATH="/usr/share/tuyaopen_models/mdtc_chunk_300ms.mnn"
CONFIG_KWS_MODEL_TOKEN_PATH="/usr/share/tuyaopen_models/tokens.txt"
# CONFIG_ENABLE_KEYBOARD_INPUT is not set
CONFIG_BOARD_CHOICE_DshanPI_A1=y
CONFIG_ENABLE_TUYA_CODEC_OPUS=y
# CONFIG_ENABLE_TUYA_CODEC_OPUS_IPC is not set
CONFIG_ENABLE_AUDIO_ALSA=y
CONFIG_ALSA_DEVICE_CAPTURE="default"
CONFIG_ALSA_DEVICE_PLAYBACK="default"
CONFIG_ALSA_BUFFER_FRAMES=4096
CONFIG_ALSA_PERIOD_FRAMES=512
CONFIG_AI_PLAYER_STACK_SIZE=16384
CONFIG_AI_PLAYER_RINGBUF_SIZE=262144
CONFIG_FLASH_FILE_PATH="/overlay/tuyadb"
