flowchart TB
    subgraph request["UI → Backend 请求链"]
        direction LR
        event["LVGL 输入事件<br/>页面 / 卡片 / 设置控件"]:::ui
        uiHandler["UI 回调<br/>构造 *_cmd_t"]:::function
        publish["mw_publish()<br/>UI_TO_BACKEND"]:::function
        clientSend["ipc_client_send()"]:::function
        requestSocket["V1 Socket<br/>header + payload"]:::socket
        process["backend main loop<br/>mw_process()"]:::function
        recv["ipc_server_recv()"]:::function
        dispatch["dispatch_backend_message()"]:::function
        route["topic → handle_*_command"]:::function

        event --> uiHandler --> publish --> clientSend --> requestSocket
        requestSocket --> process --> recv --> dispatch --> route
    end

    subgraph services["命令路由与业务服务"]
        direction LR
        wifi["Wi-Fi<br/>service_wifi_*()"]:::service
        bt["蓝牙<br/>service_bt_*()"]:::service
        ai["AI<br/>service_ai_*()"]:::service
        hdmi["HDMI<br/>service_hdmi_preview_*()"]:::service
        ota["OTA<br/>service_ota_*()"]:::service
        cloud["Cloud<br/>service_cloud_*()"]:::service
        led["LED<br/>service_led_*()"]:::service
    end

    subgraph response["Backend → UI 状态链"]
        direction RL
        status["服务发布<br/>TOPIC_*_STATUS"]:::function
        serverSend["mw_publish()<br/>ipc_server_send()"]:::function
        responseSocket["V1 Socket<br/>header + payload"]:::socket
        uiTimer["mw_timer_callback()<br/>每 10 ms"]:::function
        uiDispatch["dispatch_ui_message()<br/>UI subscriber"]:::function
        redraw["更新状态<br/>LVGL 重绘"]:::ui

        status --> serverSend --> responseSocket --> uiTimer --> uiDispatch --> redraw
    end

    route --> wifi & bt & ai & hdmi & ota & cloud & led
    wifi & bt & ai & hdmi & ota & cloud & led --> status

    v2["IPC V2（增量）<br/>4 字节大端长度 + JSON<br/>backend_v2_server"]:::contract
    v2 -. "兼容窗口内接入相同用例" .-> route

    classDef ui fill:#FFF0F3,stroke:#D66B87,color:#3D2430,stroke-width:2px;
    classDef function fill:#EEF4FF,stroke:#315A9B,color:#172033,stroke-width:2px;
    classDef service fill:#EAF9F5,stroke:#278878,color:#153D36,stroke-width:2px;
    classDef socket fill:#FFF8DC,stroke:#C79A1B,color:#3D3420;
    classDef contract fill:#F2F0FF,stroke:#7567B5,color:#262044,stroke-dasharray:6 4;
