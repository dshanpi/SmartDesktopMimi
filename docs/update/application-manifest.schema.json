{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "application-manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy": {
      "const": "MIMI-UPDATE-001/1.0.0"
    },
    "release_type": {
      "const": "application"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "channel": {
      "enum": [
        "stable",
        "testing"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "package_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    },
    "expanded_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "max_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "enum": [
              420,
              493
            ]
          }
        },
        "required": [
          "sha256",
          "size",
          "mode"
        ]
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "product_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "platform_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "soc_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "board_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "hardware_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "variant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "architecture": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "isa": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "bits": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "endian": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "abi": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "libc": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "loader": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "ports_abi": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "ipc_contract": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              }
            },
            "required": [
              "product_id",
              "platform_id",
              "soc_id",
              "board_id",
              "hardware_revision",
              "variant",
              "architecture",
              "isa",
              "bits",
              "endian",
              "abi",
              "libc",
              "loader",
              "ports_abi",
              "ipc_contract"
            ]
          },
          "runtime": {
            "type": "object",
            "required": [
              "system",
              "provider",
              "updater",
              "libc"
            ],
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
                },
                "max_exclusive": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
                },
                "exclude": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
                  }
                }
              },
              "required": [
                "min",
                "max_exclusive"
              ]
            }
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            }
          }
        },
        "required": [
          "identity",
          "runtime",
          "capabilities"
        ]
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "write": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "min",
        "max",
        "write"
      ]
    }
  },
  "required": [
    "schema_version",
    "policy",
    "release_type",
    "version",
    "commit",
    "channel",
    "sequence",
    "key_id",
    "package_sha256",
    "package_bytes",
    "expanded_bytes",
    "max_files",
    "files",
    "targets",
    "data"
  ]
}
