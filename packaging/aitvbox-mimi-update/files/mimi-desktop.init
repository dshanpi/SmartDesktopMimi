#!/bin/sh /etc/rc.common
# rc.d is sorted lexically; run after S99aitvbox, never as S100 before S98.
START=99
STOP=9
start() {
    [ -f /etc/smartdesktopmimi/updater.json ] || return 0
    [ -f /overlay/smartdesktopmimi-platform/enrollment.json ] || return 0
    /usr/bin/mimi-update start-selected
}
stop() {
    ubus call service delete '{"name":"mimi-desktop"}'
}
