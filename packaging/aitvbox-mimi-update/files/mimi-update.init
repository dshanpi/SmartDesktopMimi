#!/bin/sh /etc/rc.common
START=98
STOP=11
USE_PROCD=1
start_service() {
    [ -f /etc/smartdesktopmimi/updater.json ] || return 0
    mkdir -p /run/smartdesktopmimi
    chmod 700 /run/smartdesktopmimi
    procd_open_instance updater
    procd_set_param command /usr/bin/mimi-update serve
    procd_set_param respawn 10 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
