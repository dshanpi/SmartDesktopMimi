#!/bin/sh /etc/rc.common

USE_PROCD=1
START=83
STOP=17

start_service() {
	mkdir -p /var/run/aitvbox
	chmod 0751 /var/run/aitvbox
	procd_open_instance
	procd_set_param command /usr/bin/aitvbox-appd
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
