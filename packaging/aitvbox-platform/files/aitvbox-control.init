#!/bin/sh /etc/rc.common

START=84
STOP=16
USE_PROCD=1

start_service() {
	mkdir -p /var/run/aitvbox /overlay/aitvbox/secrets
	# Native APPs run as UID 65534 and need traversal to apps.sock. Runtime
	# files and privileged sockets retain their own 0600/0660 permissions.
	chmod 0751 /var/run/aitvbox
	chmod 0700 /overlay/aitvbox/secrets

	procd_open_instance
	procd_set_param command /usr/bin/aitvbox-controld
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/bin/aitvbox-agentctl stop >/dev/null 2>&1 || true
	rm -f /var/run/aitvbox/control.sock
}
