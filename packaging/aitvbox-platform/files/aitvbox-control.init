#!/bin/sh /etc/rc.common

START=84
STOP=16
USE_PROCD=1

start_service() {
	mkdir -p /var/run/aitvbox /overlay/aitvbox/secrets || return 1
	# Native APPs run as UID 65534 and need traversal to apps.sock. Runtime
	# files and privileged sockets retain their own 0600/0660 permissions.
	chmod 0751 /var/run/aitvbox || return 1
	chmod 0700 /overlay/aitvbox/secrets || return 1

	procd_open_instance
	procd_set_param command /usr/bin/aitvbox-controld
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	if ! /usr/bin/aitvbox-agentctl stop >/dev/null 2>&1; then
		logger -t aitvbox-control "agent stop request or HID release failed; continuing service cleanup" ||
			printf '%s\n' "agent stop request or HID release failed; continuing service cleanup" >&2
	fi
	rm -f /var/run/aitvbox/control.sock
}
