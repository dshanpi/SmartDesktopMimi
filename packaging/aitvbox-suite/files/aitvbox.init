#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
BOOT_PROGRESS_FILE=/tmp/boot_progress

boot_progress() {
	echo "$1" > "$BOOT_PROGRESS_FILE"
}

boot_log() {
	message="aitvbox-init: $*"
	echo "$message" > /dev/console 2>/dev/null || true
	logger -t aitvbox-init "$*" 2>/dev/null || true
}

log_power_snapshot() {
	for supply in /sys/class/power_supply/*; do
		[ -d "$supply" ] || continue
		name="$(basename "$supply")"
		type="$(cat "$supply/type" 2>/dev/null)"
		online="$(cat "$supply/online" 2>/dev/null)"
		voltage="$(cat "$supply/voltage_now" 2>/dev/null)"
		current="$(cat "$supply/current_now" 2>/dev/null)"
		limit="$(cat "$supply/input_current_limit" 2>/dev/null)"
		boot_log "power $name type=${type:-unknown} online=${online:-unknown} voltage_uV=${voltage:-unknown} current_uA=${current:-unknown} input_limit_uA=${limit:-unknown}"
	done
}

start_service() {
	: > /tmp/lv_backend.log
	: > /tmp/lvglsim.log
	rm -f /tmp/lv_port_linux_backend.sock
	boot_progress 78
	boot_log "starting product services (progress 78)"
	log_power_snapshot

	# TF card: only present after reboot on this hardware; quiet no-op if empty.
	# Mount before video service so playlist scan can see /mnt/SDCARD.
	if [ -x /usr/bin/aitvbox-mount-sdcard ]; then
		/usr/bin/aitvbox-mount-sdcard start || true
	fi

	procd_open_instance lv_backend
	procd_set_param command /bin/sh -c "export HOME=/tmp LV_SETTINGS_FILE=/overlay/lv_port_linux_settings.bin LV_AI_RUNTIME=tuya LV_AI_TUYA_BIN=/usr/bin/your_chat_bot_QIO_1.0.1.bin TUYA_CHAT_BOT_BIN=/usr/bin/your_chat_bot_QIO_1.0.1.bin HDMI_PREVIEW_BIN=/usr/bin/hdmi_preview AITVBOX_SHARED_CAPTURE=1 AITVBOX_CAPTURE_SOCKET=/var/run/aitvbox/capture.sock LD_LIBRARY_PATH=/usr/lib; cd /tmp && exec /usr/bin/lv_backend >>/tmp/lv_backend.log 2>&1"
	procd_set_param respawn 5 10 3
	procd_close_instance
	boot_progress 84
	boot_log "lv_backend queued; waiting for UI handoff (progress 84)"

	# The helper waits for backend IPC, stops boot-play, waits until it has
	# released the framebuffer, then starts LVGL.
	procd_open_instance lvglsim
	procd_set_param command /usr/bin/aitvbox-start-ui
	procd_set_param respawn 5 10 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall your_chat_bot_QIO_1.0.1.bin 2>/dev/null
	killall hdmi_preview 2>/dev/null
	killall lv_backend 2>/dev/null
	killall lvglsim 2>/dev/null
	rm -f /tmp/lv_port_linux_backend.sock
	if [ -x /usr/bin/aitvbox-mount-sdcard ]; then
		/usr/bin/aitvbox-mount-sdcard stop || true
	fi
}
