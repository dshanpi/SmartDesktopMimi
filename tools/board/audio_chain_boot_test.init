#!/bin/sh /etc/rc.common

START=99

console_run() {
	"$@" > /dev/console 2>&1
	result=$?
	echo "audio-chain-test: exit=${result} command=$*" > /dev/console
	return "${result}"
}

boot() {
	(
		# Package installation already creates the START=99 rc.d link.  Keep
		# the test single-shot even if a stale/manual link is also present.
		lock_dir=/tmp/aitvbox-audio-diagnostic.lock
		if ! mkdir "${lock_dir}" 2>/dev/null; then
			echo "audio-chain-test: already running, skip duplicate" > /dev/console
			exit 0
		fi
		trap 'rmdir /tmp/aitvbox-audio-diagnostic.lock 2>/dev/null || true' EXIT INT TERM

		# Wait for the codec, HDMI bridge, product services and delayed PA_SHDN
		# enable in audio_init to settle before exercising either audio path.
		sleep 25
		echo "audio-chain-test: begin" > /dev/console
		echo "audio-chain-test: uname=$(uname -a)" > /dev/console
		if [ -r /etc/aitvbox-version ]; then
			echo "audio-chain-test: product-version=$(cat /etc/aitvbox-version)" > /dev/console
		fi
		if [ -r /proc/asound/cards ]; then
			echo "audio-chain-test: asound-cards-begin" > /dev/console
			cat /proc/asound/cards > /dev/console
			echo "audio-chain-test: asound-cards-end" > /dev/console
		fi

		console_run /usr/bin/aplay -l
		console_run /usr/bin/arecord -l
		console_run /usr/bin/amixer -c 0 contents

		# R818 V10: both NS4150C amplifiers share PA_SHDN on SoM PB6.
		if [ -w /sys/kernel/debug/sunxi_pinctrl/function ] &&
		   [ -w /sys/kernel/debug/sunxi_pinctrl/data ]; then
			echo 'PB6 1' > /sys/kernel/debug/sunxi_pinctrl/function
			echo 'PB6 1' > /sys/kernel/debug/sunxi_pinctrl/data
			echo "audio-chain-test: PB6 PA_SHDN forced high" > /dev/console
		fi

		/usr/bin/amixer -q -c 0 cset name='DAC volume' 159,159
		/usr/bin/amixer -q -c 0 cset name='digital volume' 63
		/usr/bin/amixer -q -c 0 cset name='Headphone Switch' on
		/usr/bin/amixer -q -c 0 cset name='Headphone Volume' 5
		/usr/bin/amixer -q -c 0 cset name='HpSpeaker Switch' on

		# The file contains different left/right tones. Test both plausible codec
		# output routes independently so amplifier hardware is separated from the
		# HDMI/I2S capture result.
		echo "audio-chain-test: HPOUT_TONE_BEGIN" > /dev/console
		console_run /usr/bin/aplay -D PlaybackHpoutSpeaker /etc/audio-chain-test.wav
		echo "audio-chain-test: HPOUT_TONE_END" > /dev/console
		sleep 3

		echo "audio-chain-test: LINEOUT_TONE_BEGIN" > /dev/console
		console_run /usr/bin/aplay -D PlaybackLineoutSpeaker /etc/audio-chain-test.wav
		echo "audio-chain-test: LINEOUT_TONE_END" > /dev/console
		sleep 3

		# Both lv_backend and IPKVM supervise HDMI capture children. Stop the
		# supervisors before testing; killing only hdmi_preview races its parent
		# and lets a replacement process reclaim /dev/video0 or HDMIIn.
		aitvbox_was_running=0
		if pidof lv_backend lvglsim >/dev/null 2>&1; then
			aitvbox_was_running=1
			/etc/init.d/aitvbox stop > /dev/console 2>&1 || true
		fi
		ipkvm_was_running=0
		if pidof aitvbox-ipkvmd aitvbox-kvm-video >/dev/null 2>&1; then
			ipkvm_was_running=1
			/etc/init.d/aitvbox-ipkvm stop > /dev/console 2>&1 || true
		fi

		count=0
		while pidof lv_backend lvglsim hdmi_preview aitvbox-ipkvmd \
			aitvbox-kvm-video >/dev/null 2>&1 && [ "${count}" -lt 12 ]; do
			sleep 1
			count=$((count + 1))
		done
		killall -TERM hdmi_preview aitvbox-kvm-video 2>/dev/null || true
		sleep 1
		killall -KILL hdmi_preview aitvbox-kvm-video 2>/dev/null || true

		rm -f /tmp/hdmi-i2s.raw /tmp/hdmi_preview.log
		echo "audio-chain-test: HDMI_CAPTURE_BEGIN" > /dev/console
		console_run /usr/bin/arecord -D HDMIIn -t raw -f S16_LE -c 2 -r 44100 \
			-d 8 /tmp/hdmi-i2s.raw
		if [ -s /tmp/hdmi-i2s.raw ]; then
			set -- $(od -An -v -t d2 /tmp/hdmi-i2s.raw | awk '
				BEGIN { total=0; nonzero=0; peak=0 }
				{
					for (i=1; i<=NF; i++) {
						v=$i; total++;
						if (v != 0) nonzero++;
						if (v < 0) v=-v;
						if (v > peak) peak=v;
					}
				}
				END { print total, nonzero, peak }')
			echo "audio-chain-test: HDMI_PCM samples=$1 nonzero=$2 peak=$3 bytes=$(wc -c < /tmp/hdmi-i2s.raw)" > /dev/console
		else
			echo "audio-chain-test: HDMI_PCM missing" > /dev/console
		fi

		HDMI_PREVIEW_STATUS_SOCK=/tmp/audio_chain_status.sock \
			/usr/bin/hdmi_preview --probe > /dev/console 2>&1
		probe_result=$?
		echo "audio-chain-test: probe_result=${probe_result}" > /dev/console
		if [ "${probe_result}" -eq 0 ]; then
			HDMI_PREVIEW_STATUS_SOCK=/tmp/audio_chain_status.sock \
				/usr/bin/hdmi_preview --service --display \
				> /dev/console 2>&1 &
			preview_pid=$!
			sleep 30
			kill -TERM "${preview_pid}" 2>/dev/null || true
			wait "${preview_pid}" 2>/dev/null || true
		fi
		if [ "${ipkvm_was_running}" -eq 1 ]; then
			/etc/init.d/aitvbox-ipkvm start > /dev/console 2>&1 || true
		fi
		if [ "${aitvbox_was_running}" -eq 1 ]; then
			/etc/init.d/aitvbox start > /dev/console 2>&1 || true
		fi
		echo "audio-chain-test: preview-log-begin" > /dev/console
		tail -n 100 /tmp/hdmi_preview.log > /dev/console 2>&1 || true
		echo "audio-chain-test: complete" > /dev/console
	) &
}
