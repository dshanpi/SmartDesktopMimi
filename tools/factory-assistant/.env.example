# 非敏感工位信息
FACTORY_API_BASE=https://factory.example.com
FACTORY_ID=factory-01
LINE_ID=line-01
STATION_ID=station-01
BATCH_NUMBER=20260719-A
TUYA_PID=1234567890ABCDEF
FIRMWARE_SHA256=replace-with-64-char-firmware-sha256

# 文件路径。正式环境由管理员安装，禁止提交真实文件。
FACTORY_CLIENT_CERT=/etc/aitvbox-factory/station.crt
FACTORY_CLIENT_KEY=/etc/aitvbox-factory/station.key
FACTORY_CA_FILE=/etc/aitvbox-factory/ca.crt
FACTORY_SIGNING_PUBKEY=/etc/aitvbox-factory/device-signing-public.pem

# 可选
# FACTORY_HARDWARE_TEST_BIN=/opt/aitvbox-factory/bin/hardware-test
# AITVBOX_ADB_PATH=/usr/bin/adb
# AITVBOX_FACTORY_RUNNER=/path/to/factory_provision_device.sh
