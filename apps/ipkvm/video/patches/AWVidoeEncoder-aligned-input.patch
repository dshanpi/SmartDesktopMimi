+    bufferParam.nSizeY = ALIGN_XXB(16, baseConfig.nInputWidth) *
+                         ALIGN_XXB(16, baseConfig.nInputHeight) + 1024;
+    bufferParam.nSizeC = ALIGN_XXB(16, baseConfig.nInputWidth) *
+                         ALIGN_XXB(16, baseConfig.nInputHeight) / 2 + 1024;
+    bufferParam.nBufferNum = 4;
 
