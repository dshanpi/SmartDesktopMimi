# Relocatable application SDK; no Tina checkout or system build is required.
set(MIMI_SDK_ARCHITECTURE "$ENV{MIMI_SDK_ARCHITECTURE}")
if(NOT MIMI_SDK_ARCHITECTURE OR MIMI_SDK_ARCHITECTURE STREQUAL "aarch64")
  set(CMAKE_SYSTEM_NAME Linux)
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
elseif(MIMI_SDK_ARCHITECTURE STREQUAL "x86_64")
  # Native compiler with an isolated target sysroot, not cross-board support.
  set(CMAKE_SYSTEM_PROCESSOR x86_64)
else()
  message(FATAL_ERROR "Unsupported verified SDK architecture")
endif()
set(MIMI_SDK_ROOT "$ENV{MIMI_SDK_ROOT}" CACHE PATH "Verified application SDK")
if(NOT IS_ABSOLUTE "${MIMI_SDK_ROOT}" OR NOT EXISTS "${MIMI_SDK_ROOT}/sdk-lock.json")
  message(FATAL_ERROR "Use tools/update/application_sdk.py build with a verified SDK")
endif()
set(TOOLCHAIN_ROOT "${MIMI_SDK_ROOT}/toolchain")
set(SYSROOT_PATH "${MIMI_SDK_ROOT}/sysroot")
set(CMAKE_SYSROOT "${SYSROOT_PATH}")
set(MIMI_COMPILER_PREFIX "$ENV{MIMI_COMPILER_PREFIX}")
if(NOT MIMI_COMPILER_PREFIX)
  set(MIMI_COMPILER_PREFIX "aarch64-openwrt-linux-")
endif()
if(NOT MIMI_COMPILER_PREFIX MATCHES "^(aarch64-openwrt-linux-|aarch64-linux-gnu-|x86_64-linux-gnu-)$")
  message(FATAL_ERROR "Unsupported verified SDK compiler prefix")
endif()
if(MIMI_SDK_ARCHITECTURE STREQUAL "x86_64")
  if(NOT MIMI_COMPILER_PREFIX STREQUAL "x86_64-linux-gnu-")
    message(FATAL_ERROR "SDK architecture and compiler prefix differ")
  endif()
  set(MIMI_MULTIARCH x86_64-linux-gnu)
else()
  if(MIMI_COMPILER_PREFIX STREQUAL "x86_64-linux-gnu-")
    message(FATAL_ERROR "SDK architecture and compiler prefix differ")
  endif()
  set(MIMI_MULTIARCH aarch64-linux-gnu)
endif()
set(CMAKE_C_COMPILER "${TOOLCHAIN_ROOT}/bin/${MIMI_COMPILER_PREFIX}gcc")
set(CMAKE_CXX_COMPILER "${TOOLCHAIN_ROOT}/bin/${MIMI_COMPILER_PREFIX}g++")
set(CMAKE_AR "${TOOLCHAIN_ROOT}/bin/${MIMI_COMPILER_PREFIX}ar")
set(CMAKE_RANLIB "${TOOLCHAIN_ROOT}/bin/${MIMI_COMPILER_PREFIX}ranlib")
set(CMAKE_STRIP "${TOOLCHAIN_ROOT}/bin/${MIMI_COMPILER_PREFIX}strip")
set(ENV{STAGING_DIR} "${MIMI_SDK_ROOT}")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${SYSROOT_PATH}")
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${SYSROOT_PATH}/usr/lib/${MIMI_MULTIARCH}/pkgconfig:${SYSROOT_PATH}/usr/lib/pkgconfig:${SYSROOT_PATH}/usr/share/pkgconfig")
set(CMAKE_FIND_ROOT_PATH "${TOOLCHAIN_ROOT}" "${SYSROOT_PATH}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -Wl,-rpath-link,${SYSROOT_PATH}/lib -Wl,-rpath-link,${SYSROOT_PATH}/usr/lib -Wl,-rpath-link,${SYSROOT_PATH}/lib/${MIMI_MULTIARCH} -Wl,-rpath-link,${SYSROOT_PATH}/usr/lib/${MIMI_MULTIARCH}")
