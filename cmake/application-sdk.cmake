# Relocatable application SDK; no Tina checkout or system build is required.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(MIMI_SDK_ROOT "$ENV{MIMI_SDK_ROOT}" CACHE PATH "Verified application SDK")
if(NOT IS_ABSOLUTE "${MIMI_SDK_ROOT}" OR NOT EXISTS "${MIMI_SDK_ROOT}/sdk-lock.json")
  message(FATAL_ERROR "Use tools/update/application_sdk.py build with a verified SDK")
endif()
set(TOOLCHAIN_ROOT "${MIMI_SDK_ROOT}/toolchain")
set(SYSROOT_PATH "${MIMI_SDK_ROOT}/sysroot")
set(CMAKE_SYSROOT "${SYSROOT_PATH}")
set(CMAKE_C_COMPILER "${TOOLCHAIN_ROOT}/bin/aarch64-openwrt-linux-gcc")
set(CMAKE_CXX_COMPILER "${TOOLCHAIN_ROOT}/bin/aarch64-openwrt-linux-g++")
set(CMAKE_AR "${TOOLCHAIN_ROOT}/bin/aarch64-openwrt-linux-ar")
set(CMAKE_RANLIB "${TOOLCHAIN_ROOT}/bin/aarch64-openwrt-linux-ranlib")
set(CMAKE_STRIP "${TOOLCHAIN_ROOT}/bin/aarch64-openwrt-linux-strip")
set(ENV{STAGING_DIR} "${MIMI_SDK_ROOT}")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${SYSROOT_PATH}")
set(ENV{PKG_CONFIG_LIBDIR} "${SYSROOT_PATH}/usr/lib/pkgconfig:${SYSROOT_PATH}/usr/share/pkgconfig")
set(CMAKE_FIND_ROOT_PATH "${TOOLCHAIN_ROOT}" "${SYSROOT_PATH}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -Wl,-rpath-link,${SYSROOT_PATH}/lib -Wl,-rpath-link,${SYSROOT_PATH}/usr/lib")
